AUTH_MODE=oidc
OIDC_ISSUER=https://identity.example.com/realms/enterprise
OIDC_CLIENT_ID=REPLACE-WITH-CLIENT-ID
OIDC_CLIENT_SECRET=REPLACE-LOCALLY-NEVER-COMMIT
OIDC_SCOPES="openid profile email"
OIDC_TOKEN_AUTH_METHOD=client_secret_basic
OIDC_SIGNING_ALGORITHMS=RS256
OIDC_ADMIN_CLAIM=/roles
OIDC_ADMIN_VALUE=mcp-admin
OIDC_ADMIN_CLAIM_SOURCE=id_token
# Optional JWT API automation audience; not sent as an authorization parameter.
OIDC_API_AUDIENCE=
# Optional provider extensions; cannot override reserved OIDC fields.
OIDC_AUTHORIZATION_PARAMS='{}'
CONTROL_PLANE_PUBLIC_URL=http://127.0.0.1:8080
GATEWAY_PUBLIC_URL=https://mcp.company.com
REGISTRY_DATABASE=/tmp/mcp-registry.sqlite3
